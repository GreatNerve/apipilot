{
  "swagger": "2.0",
  "info": { "title": "Legacy Notes", "version": "0.9" },
  "host": "notes.example.com",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "apiKey": { "type": "apiKey", "name": "X-Api-Key", "in": "header" }
  },
  "security": [{ "apiKey": [] }],
  "paths": {
    "/notes": {
      "post": {
        "operationId": "createNote",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/NoteInput" }
          }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Note" } }
        }
      }
    },
    "/notes/{noteId}": {
      "get": {
        "operationId": "getNote",
        "parameters": [
          { "name": "noteId", "in": "path", "required": true, "type": "integer", "format": "int64" }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/Note" } }
        }
      }
    }
  },
  "definitions": {
    "NoteInput": {
      "type": "object",
      "required": ["text"],
      "properties": { "text": { "type": "string", "maxLength": 280 } }
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "text": { "type": "string" }
      }
    }
  }
}
